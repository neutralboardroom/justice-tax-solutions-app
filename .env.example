# Justice Tax Solutions environment template
NODE_ENV=development
PORT=10000
PUBLIC_BASE_URL=https://justicetaxsolutions.com
DEFAULT_PUBLIC_BASE_URL=https://justicetaxsolutions.com

# Security/session
JWT_SECRET=replace_with_long_random_secret
ADMIN_TOKEN=replace_with_admin_token
STAFF_SIGNUP_CODE=
REQUIRE_STAFF_APPROVAL=false
AUDIT_HASH_SALT=

# Storage
DATA_ADAPTER=json-local
# For production choose DATA_ADAPTER=postgres after DATABASE_URL and schema migration are ready.
DATA_DIR=data
UPLOAD_DIR=storage/uploads
DATABASE_URL=
DOCUMENT_ENCRYPTION_KEY=replace_with_32_plus_character_document_key
SECURE_OBJECT_STORAGE_CONFIGURED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Owner/staff notification and account recovery placeholders
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=

# Payment placeholders for future Stripe wiring and release gates
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://justicetaxsolutions.com/dashboard.html?payment=success
PAYMENT_CANCEL_URL=https://justicetaxsolutions.com/pricing.html?payment=cancelled
PRODUCTION_PAYMENT_CONFIGURED=false
REQUIRE_PAYMENT_BEFORE_RELEASE=true

# Multi-AI vendors. Leave blank to disable a provider.
AI_VENDOR_ORDER=openai,gemini,anthropic,xai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Optional production OCR / document-AI flags (v0.1.6)
# Set one of these only after a real provider integration exists and has been security-reviewed.
OCR_PROVIDER_CONFIGURED=false
TEXTRACT_CONFIGURED=false
GOOGLE_DOCUMENT_AI_CONFIGURED=false

# Official form library (v0.1.6)
OFFICIAL_FORM_DIR=storage/official-forms

# v0.1.8 live paying-user readiness controls
LIVE_PAYING_USERS_ENABLED=false
MALWARE_SCANNING_CONFIGURED=false
OCR_PROVIDER_CONFIGURED=false
TEXTRACT_CONFIGURED=false
GOOGLE_DOCUMENT_AI_CONFIGURED=false
REQUIRE_STAFF_APPROVAL=true
STAFF_SIGNUP_CODE=change-me-before-production

# v0.1.14 production configuration layer
# Keep these false until the Render/PostgreSQL/private-storage/malware/email/Stripe/professional gates pass.
ALLOW_SENSITIVE_DOCUMENT_UPLOADS=false
ALLOW_REDACTED_SAMPLE_UPLOADS=true
DOCUMENT_STORAGE_PROVIDER=encrypted-local
# For production choose: s3, r2, or gcs, then configure the related provider values.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
MALWARE_SCANNING_PROVIDER=disabled
CLAMAV_URL=
OPSWAT_API_KEY=
EMAIL_DOMAIN_AUTHENTICATED=false
SPF_DKIM_DMARC_CONFIGURED=false


# v0.1.14 production adapter / pilot-gate controls
POSTGRES_SSL=true
POSTGRES_POOL_MAX=10
STAFF_MFA_REQUIRED=false
MFA_REQUIRED=false
EMAIL_FROM=no-reply@justicetaxsolutions.com
EMAIL_REPLY_TO=reachrgnow@gmail.com
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
DOCUMENT_SCAN_QUARANTINE_DEFAULT=true
PUBLIC_LAUNCH_APPROVED=false
CONTROLLED_PAID_PILOT_APPROVED=false

# v0.1.26 IRS Form 9465 output plus production security approvals
# Keep every approval false until the operating procedure is real, documented, tested, and owner-approved.
SECURITY_GO_LIVE_APPROVED=false
WISP_APPROVED=false
DATA_RETENTION_POLICY_APPROVED=false
INCIDENT_RESPONSE_PLAN_APPROVED=false
BACKUP_RESTORE_TESTED=false
PROFESSIONAL_VERIFICATION_COMPLETE=false
OFFICIAL_FORM_OUTPUT_APPROVED=false
DOCUMENT_ACCESS_REVIEW_COMPLETED=false
SECURITY_REVIEW_OWNER_EMAIL=reachrgnow@gmail.com
SECURITY_REVIEW_CADENCE_DAYS=90

# Appointment/calendar integration placeholders (manual scheduling works first)
DEFAULT_CALENDAR_PROVIDER=manual_staff_entry
DEFAULT_MEETING_PROVIDER=manual_staff_entry
APPOINTMENT_TIMEZONE=America/New_York
STAFF_MEETING_LINK_FALLBACK=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
CALENDLY_API_KEY=
CALENDLY_WEBHOOK_SECRET=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# v0.1.27 payments, quotes, transactional emails, and appointment confirmations
PRODUCTION_PAYMENT_CONFIGURED=false
REQUIRE_QUOTE_APPROVAL_FOR_COMPLEX_SERVICES=true
REQUIRE_PAYMENT_BEFORE_APPOINTMENT=false
REQUIRE_PAYMENT_BEFORE_RELEASE=true
TRANSACTIONAL_EMAIL_PROVIDER=manual
TRANSACTIONAL_EMAIL_DOMAIN_AUTHENTICATED=false
NO_SENSITIVE_DETAILS_IN_EMAIL=true
APPOINTMENT_REMINDERS_ENABLED=false
APPOINTMENT_CONFIRMATION_MANUAL_FALLBACK=true
QUOTE_EXPIRATION_DAYS=14
